# Copy this file to .env and fill in the values below.
# .env is gitignored (it holds secrets) — this template is what's checked in instead.

DATABASE_URL="file:./dev.db"

# Web Push — generate a fresh pair with `npx web-push generate-vapid-keys` and paste the output below.
# Required for the "Enable notifications" button on the Settings page to work.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# A secret only you (and your scheduler, once deployed) know. Any string works — required by
# GET /api/cron/reminders, which computes and sends today's notifications when hit with
# `Authorization: Bearer <this value>`.
CRON_SECRET="change-me-to-a-random-string"

# EDMTrain — apply for a free client API key at edmtrain.com/developer-api (requires an
# EDMTrain account). Location defaults below are Toronto; change if that's not your city.
EDMTRAIN_API_KEY=""
EDMTRAIN_LATITUDE="43.6532"
EDMTRAIN_LONGITUDE="-79.3832"
EDMTRAIN_STATE="ON"
